{% extends 'base.html.twig' %}

{% block title %}Evènements{% endblock %}

{% block body %}

<div class="container mt-5">
<div class="row">
    {% for event in events %}
<div class="col-md-12">
    <div class="card mb-3 mt-3 eventCard">
        <div class="row g-0">
            <div class="col-md-4">
                {% set mainPicture='https://picsum.photos/200/300' %}
                {% if event.imagePath|length > 0 %}
                    {% set mainPicture = event.imagePath ~ '?rand=' ~ random(1000) %}
                {% endif %}
                <img src="{{ mainPicture }}" class="img-fluid rounded-start" alt="img">
            </div>
            <div class="col-md-8">
                <div class="card-body">
                    <h5 class="card-title">{{ event.title }}</h5>
                    <p class="card-text">{{ event.description }}</p>
                    <p class="card-text"><small class="text-body-secondary">{{ event.date.format('d/m/Y') }}</small></p>
                </div>
            </div>
        </div>
    </div>
</div>
    {% endfor %}
    </div>
    </div>
    <div class="navigation">
        {{ knp_pagination_render(events) }}
    </div





{% endblock %}
