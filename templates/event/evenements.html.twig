{% extends 'base.html.twig' %}

{% block title %}Evènements{% endblock %}

{% block body %}

    <h1 class="text-center titleAdmin mt-5 ">Agenda</h1>

    <div class="container mt-5 w-75 mx-auto">
        <div class="row">
            {% for event in events %}
                <div class="col-md-12">
                    <div class="card mb-3 mt-3 eventCard">
                        <div class="row g-0">
                            <div class="col-md-4">
                                {% set mainPicture='https://picsum.photos/200/300' %}
                                {% if event.imagePath|length > 0 %}
                                    {% set mainPicture = event.imagePath ~ '?rand=' ~ random(1000) %}
                                {% endif %}
                                <img src="{{ mainPicture }}" class="img-fluid rounded-start w-75" alt="img">
                            </div>
                            <div class="col-md-8">
                                <div class="card-body ">
                                    <h5 class="card-title d-flex justify-content-center mt-3 mb-4">{{ event.title }}</h5>
                                    <p class="card-text mx-5">{{ event.description }}</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>

    <div class="navigation">
        {{ knp_pagination_render(events, '@KnpPaginator/Pagination/bootstrap_v5_pagination.html.twig') }}        </div>




{% endblock %}
