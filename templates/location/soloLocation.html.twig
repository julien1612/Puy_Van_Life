{% extends 'base.html.twig' %}

{% block body %}

<div class="container-fluid">
    <h1 class="soloLocationH1"><img class="iconCc" src="{{ asset('pictures/icon_cc.svg') }}"
                                    alt="icon_cc"> {{ location.address }}</h1>
    <div class="container">
        <div class="d-flex ">
            <div class="p-2 flex-fill">
                {% for picture in pictures %}
                    <img class="imgPicture mb-4" src="{{ picture.path }}" alt="picture_loc">
                {% endfor %}
            </div>
            <div class="p-2 flex-fill">
                <div class="card descriptionCard">
                    <div class="card-body">
                        <p class="card-title"><strong>Type:</strong> {{ location.type }}</p>
                        <p class="card-subtitle mb-2 text-body-secondary"><strong>Créé
                                le:</strong> {{ location.createdAt.format('d/m/Y') }}</p>
                        <p class="card-text"><strong>Description:</strong>{{ location.description }}</p>
                        <p><strong>Prix du stationnement:</strong> {{ location.price }}€</p>

                        <p><strong>Avis:</strong></p>
                        <div class="cardComment d-flex">
                            <div class="justify-content-center">
                                {% for comment in comments %}
                                    <div class="card text-center mb-4">
                                        <div class="card-header">
                                            Par: {{ comment.user.username }} le: {{ comment.commentDate.format('d/m/Y') }}
                                        </div>
                                        <div class="card-body">
                                            <p class="card-text">{{ comment.rating }}/10<br>{{ comment.comment }}</p>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

    {% endblock %}
