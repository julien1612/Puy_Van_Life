{% extends 'base.html.twig' %}

{% block title %}Spot{% endblock %}

{% block body %}

    <div class="container-fluid">
        <h1 class="soloLocationH1"><img class="iconCc" src="{{ asset('pictures/icon_cc.svg') }}"
                                        alt="icon_cc"> {{ location.address }}</h1>
        <div class="container">
            <div class="d-flex ">
                <div class="p-2 flex-fill col-md-3">
                    {% for picture in pictures %}
                        <img class="imgPicture mb-4" src="{{ picture.path }}" alt="picture_loc">
                    {% endfor %}
                </div>
                <div class="p-2 flex-fill col-md-7">
                    <div class="card descriptionCard">
                        <div class="card-body">

                            {# 3 #}
                            <div class="star">
                                <div data-favorite={{ location.id }} >
                                    {% if isLocationFavorite(app.user, location) %}
                                    <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="currentColor" class="bi bi-star-fill" viewBox="0 0 16 16">
                                        <path d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z"/>
                                    </svg>
                                    {% else %}
                                    <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="currentColor" class="bi bi-star text-warning" viewBox="0 0 16 16">
                                        <path d="M2.866 14.85c-.078.444.36.791.746.593l4.39-2.256 4.389 2.256c.386.198.824-.149.746-.592l-.83-4.73 3.522-3.356c.33-.314.16-.888-.282-.95l-4.898-.696L8.465.792a.513.513 0 0 0-.927 0L5.354 5.12l-4.898.696c-.441.062-.612.636-.283.95l3.523 3.356-.83 4.73zm4.905-2.767-3.686 1.894.694-3.957a.56.56 0 0 0-.163-.505L1.71 6.745l4.052-.576a.53.53 0 0 0 .393-.288L8 2.223l1.847 3.658a.53.53 0 0 0 .393.288l4.052.575-2.906 2.77a.56.56 0 0 0-.163.506l.694 3.957-3.686-1.894a.5.5 0 0 0-.461 0z"/>
                                    </svg>

                                {% endif %}
                                </div>
                            </div>
                            <p class="card-title"><strong>Type:</strong> {{ location.type }}</p>
                            <p class="card-subtitle mb-2 text-body-secondary"><strong>Créé
                                    le:</strong> {{ location.createdAt.format('d/m/Y') }}</p>
                            <p class="card-text"><strong>Description:</strong>{{ location.description }}</p>
                            <p><strong>Prix du stationnement:</strong> {{ location.price }}€</p>

                            <p><strong>Avis:</strong></p>
                            <div class="cardComment d-flex">
                                <div class="justify-content-center">
                                    {% for comment in comments %}
                                        <div class="card text-center mb-4">
                                            <div class="card-header">
                                               <div>Par: {{ comment.user.username }}</div>
                                               <small>le: {{ comment.commentDate.format('d/m/Y') }}</small>
                                            </div>
                                            <div class="card-body">
                                                <p class="card-text">{{ comment.rating }}/10<br>{{ comment.comment }}
                                                </p>
                                            </div>
                                        </div>
                                    {% endfor %}

                                    {% if app.user %}

                                        <button class="btn btn-secondary buttonHeader w-25" type="submit"
                                                aria-expanded="false"><a href="{{ path('app_comment', {'id': location.id}) }}"> Ecrire un commentaire</a>
                                        </button>

                                    {% else %}
                                    {% endif %}
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


{% endblock %}
