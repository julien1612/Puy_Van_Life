{% extends 'base.html.twig' %}

{% block title %}Les spots{% endblock %}

{% block body %}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
          crossorigin=""/>

    <div class="container">
        <div class="row mt-5">
            <div class="col-9">
                <div id="map"
                     data-location-items="{{ jsonLocations }}"
                >
                </div>
            </div>
            <div class="col-3">
                <div class="row overflow-y-auto w-100 containerCard">
                    {% for location in locations %}
                        <div class="col-12" data-location-id="{{ location.id }}" id="#location-{{ location.id }}">
                            <div class="card cardLocation">
                                <div class="card-body">
                                    <div id={{ location.id }}>
                                        <h4>{{ location.address }}</h4>
                                        <p>{{ location.description }}</p>
                                        <button class="btn btn-secondary buttonCard" type="button"
                                                aria-expanded="false">
                                            <a class="textButton" href="{{ path('soloLocation_app', {'id': location.id}) }}">Voir plus</a>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>

        </div>
    </div>




    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossOrigin=""></script>
{% endblock %}
