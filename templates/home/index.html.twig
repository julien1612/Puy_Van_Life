{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}

            <h2 class="bannerText">Prêts à conquérir le géant endormi ?<br> Le Puy de Dôme en van, c'est l'expédition <strong>ultime !</strong>
            </h2>

<div class="titleH2">
    <h2>Lieux à découvrir</h2>
    </div>
    <div class="container w-75">
        <h5 class="textH5"><i>Le van n'est pas qu'un simple véhicule, c'est une invitation. Une fenêtre ouverte
                sur l'horizon, un abri nomade où chaque kilomètre dessine une nouvelle liberté. C'est l'appel du large,
                la douceur des matins improvisés et la promesse d'aventures, juste là, sur quatre roues.<br>
                <strong>Découvrez les meilleurs spots, partagés par des passionnés. L'évasion commence ici.</strong>
            </i></h5>
    </div>

    <div class="lastLocation">
        <div class="row align-items-stretch">
        {% for location in lastLocation %}
        <div class="col-md-4 mb-4">
            <div class="card indexCard h-100">

                    {% set mainPicture='https://picsum.photos/200/300' %}
                    {% if location.picture|length > 0 %}
                        {% set mainPicture = location.picture[0].path ~ '?rand=' ~ random(1000) %}
                    {% endif %}
                    <img src="{{ mainPicture }}" class="card-img-top" alt="pictureLocation">
                    <div class="card-body p-1 d-flex flex-column">
                    <h5 class="card-title titleCard mx-2 mb-3">{{ location.address }}</h5>
                    <p class="card-text textCard mx-2 flex-grow-1 mb-0">{{ location.description | u.truncate(100, '...') }}</p>
                        <div class="mt-auto mx-2 mb-2 mt-0">
                    <button class="btn btn-secondary buttonCard" type="submit"
                            aria-expanded="false"><a href="{{ path('soloLocation_app', {'id': location.id}) }}">Voir plus</a> </button>
                </div>
            </div>
            </div>
        </div>
        {% endfor %}
    </div>
    </div>

    <h2 class="titleWeather">Point météo</h2>

    <div class="container col-md-8">
        <div class="card text-bg-dark">
            <img src="{{ asset('pictures/puy-dome-JQvrJtqI4Yg-unsplash (1).jpg') }}" class="card-img, img-fluid pictureWeather"
                 alt="pictureWeather">
            <div class="card-img-overlay infoWeather">

                {# Carte pour afficher les informations météo #}
                <h5 class="card-title">Clermont Ferrand</h5>
                <p class="card-text">Température extérieure: {{ weather.current.temperature_2m }} °c</p>
                <p class="card-text">Température ressentie: {{ weather.current.apparent_temperature }} °c</p>
                <p class="card-text">Humidité: {{ weather.current.relative_humidity_2m }} %</p>
                <p class="card-text">Précipitations: {{ weather.current.precipitation }} mm</p>
                <p class="card-text">Vent: {{ weather.current.wind_speed_10m }} km/h</p>
            </div>
        </div>
        <a href="https://meteofrance.com/previsions-meteo-france/auvergne-rhone-alpes/10">Clic ici pour plus d'info</a>
    </div>
{% endblock %}
