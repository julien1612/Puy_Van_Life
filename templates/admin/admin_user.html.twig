{% extends 'base.html.twig' %}

{% block title %}Les utilisateurs:{% endblock %}

{% block body %}


    <h1 class="text-center titleAdmin">Liste des utilisateurs</h1>
    <div class="container mt-4">

        <table class="table">
            <thead>
            <tr>

                <th scope="col">id</th>
                <th scope="col">Email</th>
                <th scope="col">Roles</th>
                <th scope="col">Passeword</th>
                <th scope="col">Username</th>

            </tr>
            </thead>
            <tbody>
            {% for user in users %}
                <tr>
                    <th scope="row">{{ user.id }}</th>
                    <td>{{ user.email }}</td>
                    <td>{{ user.roles|join(', ') }}</td>
                    <td>[Mot de passe haché]</td>
                    <td>{{ user.username }}</td>

                </tr>
            {% endfor %}
        </table>

        <div class="navigation">
            {{ knp_pagination_render(users, '@KnpPaginator/Pagination/bootstrap_v5_pagination.html.twig') }}        </div>

    </div>

{% endblock %}

