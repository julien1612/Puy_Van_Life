{% extends 'base.html.twig' %}

{% block title %}Evénements{% endblock %}

{% block body %}



    <div class="container row w-50 mx-auto mt-5">
        <div class="card">
            <ul class="list-group list-group-flush">
                <li class="list-group-item"><strong>Title:</strong> {{ eventSolo.title }} </li>
